  "productPair": [
    {
      "name": "A valid pair",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "6.99",
        "nonGFProductName": "Bread",
        "nonGFPrice": "3.49",
        "category": "Bread",
        "notes": null
      },
      "expected": {
        "valid": true
      }
    },
    {
      "name": "The GF name is checked first",
      "input": {
        "gfProductName": " ",
        "gfPrice": "-1",
        "nonGFProductName": "",
        "nonGFPrice": "0"
      },
      "expected": {
        "error": "emptyProductName",
        "field": "Gluten-free product name"
      }
    },
    {
      "name": "Then the GF price",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "-1",
        "nonGFProductName": "",
        "nonGFPrice": "3.49"
      },
      "expected": {
        "error": "priceNegative"
      }
    },
    {
      "name": "Then the regular name",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "6.99",
        "nonGFProductName": "",
        "nonGFPrice": "0"
      },
      "expected": {
        "error": "emptyProductName",
        "field": "Regular product name"
      }
    },
    {
      "name": "Then the regular price",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "6.99",
        "nonGFProductName": "Bread",
        "nonGFPrice": "20000",
        "category": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected": {
        "error": "priceTooHigh",
        "value": "20000"
      }
    },
    {
      "name": "Then the category",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "6.99",
        "nonGFProductName": "Bread",
        "nonGFPrice": "3.49",
        "category": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "notes": ""
      },
      "expected": {
        "error": "categoryTooLong",
        "max": 50
      }
    },
    {
      "name": "Then the notes",
      "input": {
        "gfProductName": "GF Bread",
        "gfPrice": "6.99",
        "nonGFProductName": "Bread",
        "nonGFPrice": "3.49",
        "notes": ""
      },
      "expected": {
        "error": "notesTooLong",
        "max": 1000
      }
    }
  ]
