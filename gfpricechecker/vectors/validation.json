{
  "about": "Input limits and rules. A success carries the validated value (trimmed text, parsed number); a failure names its error case and that case's values",
  "limits": {
    "minPrice": "0.01",
    "maxPrice": "10000.00",
    "minSizeValue": "0.001",
    "maxSizeValue": "100000",
    "minQuantity": 1,
    "maxQuantity": 999,
    "minProductNameLength": 1,
    "maxProductNameLength": 200,
    "maxSizeTextLength": 50,
    "maxNotesLength": 1000,
    "maxCategoryLength": 50,
    "maxStoreNameLength": 100,
    "earliestValidDate": "1 January 2020, midnight in the user's time zone"
  },
  "price": [
    {
      "input": "0.01",
      "expected": {
        "ok": "0.01"
      }
    },
    {
      "input": "5.99",
      "expected": {
        "ok": "5.99"
      }
    },
    {
      "input": "10000.00",
      "expected": {
        "ok": "10000.00"
      }
    },
    {
      "input": "-1",
      "expected": {
        "error": "priceNegative"
      }
    },
    {
      "input": "0",
      "expected": {
        "error": "invalidPrice",
        "field": "Price"
      }
    },
    {
      "input": "0.009",
      "expected": {
        "error": "invalidPrice",
        "field": "Price"
      }
    },
    {
      "input": "10000.01",
      "expected": {
        "error": "priceTooHigh",
        "value": "10000.01"
      }
    }
  ],
  "priceString": [
    {
      "input": {
        "text": "  6.99 ",
        "fieldName": "GF Price"
      },
      "expected": {
        "ok": "6.99"
      }
    },
    {
      "input": {
        "text": "",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "emptyRequiredField",
        "field": "GF Price"
      }
    },
    {
      "input": {
        "text": "   ",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "emptyRequiredField",
        "field": "GF Price"
      }
    },
    {
      "input": {
        "text": "abc",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "invalidPrice",
        "field": "GF Price"
      }
    },
    {
      "input": {
        "text": "$6.99",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "invalidPrice",
        "field": "GF Price"
      }
    },
    {
      "input": {
        "text": "0",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "invalidPrice",
        "field": "Price"
      }
    },
    {
      "input": {
        "text": "-2",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "priceNegative"
      }
    },
    {
      "input": {
        "text": "20000",
        "fieldName": "GF Price"
      },
      "expected": {
        "error": "priceTooHigh",
        "value": "20000"
      }
    }
  ],
  "productName": [
    {
      "input": {
        "text": "  GF Bread\n",
        "fieldName": "Product name"
      },
      "expected": {
        "ok": "GF Bread"
      }
    },
    {
      "input": {
        "text": "",
        "fieldName": "Gluten-free product name"
      },
      "expected": {
        "error": "emptyProductName",
        "field": "Gluten-free product name"
      }
    },
    {
      "input": {
        "text": " \n\t ",
        "fieldName": "Product name"
      },
      "expected": {
        "error": "emptyProductName",
        "field": "Product name"
      }
    },
    {
      "input": {
        "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "fieldName": "Product name"
      },
      "expected": {
        "ok": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "input": {
        "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "fieldName": "Product name"
      },
      "expected": {
        "error": "productNameTooLong",
        "field": "Product name",
        "max": 200
      }
    },
    {
      "name": "Length counts characters as a reader sees them, not code points",
      "input": {
        "text": "éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé",
        "fieldName": "Product name"
      },
      "expected": {
        "ok": "éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"
      }
    }
  ],
  "date": [
    {
      "name": "Now is accepted",
      "input": {
        "date": "2026-06-15T16:00:00Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Toronto"
      },
      "expected": {
        "ok": "2026-06-15T16:00:00Z"
      }
    },
    {
      "name": "One second after now is in the future",
      "input": {
        "date": "2026-06-15T16:00:01Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Toronto"
      },
      "expected": {
        "error": "dateInFuture"
      }
    },
    {
      "name": "Midnight on 1 January 2020 in Toronto is accepted",
      "input": {
        "date": "2020-01-01T05:00:00Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Toronto"
      },
      "expected": {
        "ok": "2020-01-01T05:00:00Z"
      }
    },
    {
      "name": "One second earlier is too early",
      "input": {
        "date": "2020-01-01T04:59:59Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Toronto"
      },
      "expected": {
        "error": "dateBeforeEarliest"
      }
    },
    {
      "name": "The same instant is too early in Vancouver",
      "input": {
        "date": "2020-01-01T05:00:00Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Vancouver"
      },
      "expected": {
        "error": "dateBeforeEarliest"
      }
    },
    {
      "name": "Midnight on 1 January 2020 in Vancouver",
      "input": {
        "date": "2020-01-01T08:00:00Z",
        "now": "2026-06-15T16:00:00Z",
        "timeZone": "America/Vancouver"
      },
      "expected": {
        "ok": "2020-01-01T08:00:00Z"
      }
    }
  ],
