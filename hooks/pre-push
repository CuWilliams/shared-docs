#!/bin/bash
#
# pre-push - refuse direct pushes to main.
#
# Why this is a hook and not a GitHub branch protection rule: shared-docs was a
# private repo on the Free plan, where GitHub returns 403 for both classic branch
# protection and rulesets. It is public now, so a ruleset on main is the real fix;
# until one is turned on, this is client-side only.
#
# Know what that means. This is a seatbelt, not a lock:
#   - `--no-verify` bypasses it, by design.
#   - It only exists in clones that ran `git config core.hooksPath hooks`.
#   - It cannot stop a commit made through the GitHub web UI.
#
# It exists because three repos now treat this one's main as their source of
# truth for rules that are legal exposure. A push straight to main changes what
# governs the iOS app, the website and any future Android app, with no diff
# anyone reviewed.

protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/$protected_branch" ] || continue

    echo ""
    echo "  Refusing to push directly to '$protected_branch'."
    echo ""
    echo "  Three repos consume this one as their source of truth. Changes here"
    echo "  should arrive through a PR so there is a reviewable diff."
    echo ""
    echo "    git checkout -b claude/<what-changed>"
    echo "    git push -u origin claude/<what-changed>"
    echo "    gh pr create"
    echo ""
    echo "  Deliberate exception (say why in the commit): git push --no-verify"
    echo ""
    exit 1
done

exit 0
